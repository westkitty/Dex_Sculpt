{
  "name": "dex-sculpt",
  "private": true,
  "version": "0.1.0",
  "description": "DEX//SCULPT — rig-safe browser character foundry: sculpt, customize and export rigged humanoids without losing skeletons, skin weights, morph targets or animation.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5190",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5191",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "browser:setup": "node tools/headless-browser/setup.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^20.19.43",
    "@types/three": "0.186.0",
    "jsdom": "29.1.1",
    "three185": "npm:three@0.185.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
