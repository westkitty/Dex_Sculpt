{
  "name": "dex-sculpt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DEX//SCULPT — Rig-preserving browser 3D character customization, sculpting workbench, and GLB foundry.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
